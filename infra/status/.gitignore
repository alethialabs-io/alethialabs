# Never commit backend config, state, plans or the account id.
backend.hcl
.terraform/
*.tfstate
*.tfstate.*
*.tfplan
tfplan
*.tfvars.json
account.auto.tfvars

# terraform.tfvars is committed HERE on purpose, overriding `**/terraform.tfvars` in infra/.gitignore
# (and `infra/**/terraform.tfvars` in the root one) — the negation has to live in this file because it
# is deeper than both. Every value in it is public.
!terraform.tfvars
.terraform.lock.hcl
