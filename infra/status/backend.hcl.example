# AWS-native S3 backend. Copy to backend.hcl (gitignored).
#
#   tofu init -backend-config=backend.hcl
#
# The bucket already exists (infra/email-ses/bootstrap/ owns it) and is versioned. The applying
# maintainer's own AWS credentials authenticate it — no static state keys.
#
# THIS STATE HOLDS A SECRET: the Worker's STATUS_PROBE_TOKEN binding stores its text in state. Hence
# `encrypt`, and hence the bucket's access policy is the real control.

bucket       = "alethia-tofu-state-270587882865"
key          = "status/terraform.tfstate"
region       = "eu-central-1"
encrypt      = true
use_lockfile = true
