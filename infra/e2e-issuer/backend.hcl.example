# AWS-native S3 backend for OpenTofu state. Copy to backend.hcl (gitignored).
#
#   tofu init -backend-config=backend.hcl
#
# The bucket already exists (infra/email-ses/bootstrap/ owns it) and is versioned. The applying
# maintainer's own AWS credentials (env or SSO) authenticate it — no static state keys. The state
# holds no secret: the Cloudflare token is read from CLOUDFLARE_API_TOKEN by the provider and is
# never a variable, so it is never written to state or to a plan.

bucket       = "alethia-tofu-state-270587882865"
key          = "e2e-issuer/terraform.tfstate"
region       = "eu-central-1"
use_lockfile = true
