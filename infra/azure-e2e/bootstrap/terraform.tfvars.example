#
# Copy to terraform.tfvars (gitignored). Applied ONCE, before the parent infra/azure-e2e stack, by a
# maintainer with an admin identity in the DEDICATED e2e subscription.

# REQUIRED — must be the SAME subscription_id the parent infra/azure-e2e stack uses.
subscription_id = "00000000-0000-0000-0000-000000000000"

# REQUIRED in practice. The state account has shared-key auth disabled, so state access is Entra-only:
# without at least one Storage Blob Data Contributor here, `tofu init` against the real backend 403s.
#   az ad signed-in-user show --query id -o tsv
state_writer_principal_ids = ["00000000-0000-0000-0000-000000000000"]

# REQUIRED, with no default (#3290). This value IS the storage account's network posture: non-empty
# sets default_action = "Deny" and allows only these ranges; EMPTY sets "Allow".
#
# ⚠ LEFT COMMENTED OUT ON PURPOSE, and it is the only REQUIRED line in this file that is. The other
# two carry obviously-fake zero UUIDs, which Azure rejects — so an unedited copy fails loudly. An
# empty list is a VALID value that silently means "Allow", so pre-filling `= []` here would hand the
# permissive answer to anyone following the README's `cp terraform.tfvars.example terraform.tfvars`
# step, without them deciding anything. That is exactly what removing the default was meant to stop:
# "Allow" would still be reached by leaving a line alone, the line having merely moved from
# variables.tf to this file.
#
# Uncomment and answer it. `tofu plan` refuses to run until you do, naming this variable.
#   state_network_allowed_cidrs = ["203.0.113.0/24"]   # your stable egress ranges → "Deny" + allowlist
#   state_network_allowed_cidrs = []                   # "Allow", chosen deliberately
#
# Choosing `[]` is a defensible answer, not a wrong one: the account's other wall is that it has no
# shared key, so state access is an Entra role assignment only. It just has to be a choice.

# Where the state resource group + storage account live.
# location = "germanywestcentral"

# Storage account names are globally unique, lowercase alphanumeric only, 3-24 chars. Change this if
# the default is taken — and keep backend.hcl in step.
# state_storage_account_name = "alethiatfstate"
# state_resource_group_name  = "alethia-tfstate"
# state_container_name       = "tfstate"

# Soft-delete recovery window for state blobs and containers, in days (7-365).
# state_retention_days = 30
