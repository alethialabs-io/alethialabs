# Copy to terraform.tfvars (gitignored) or pass via TF_VAR_*. Applied ONCE, before the parent
# infra/gcp-e2e stack, by a maintainer with an admin identity in the DEDICATED e2e project.

# REQUIRED — must be the SAME project_id the parent infra/gcp-e2e stack uses.
# NOT "alethia-e2e-nightly" — that is the provisioner SERVICE ACCOUNT's id, not a project. The live
# project is the one in the E2E_GCP_SA_EMAIL repo variable (`alethia-e2e-nightly@<project>.iam…`).
# Its id is deliberately not written in this repo (pnpm check:forbidden-names); the placeholder below
# fails project_id validation until you replace it. Runbook: docs/testing/e2e-state-migration.md §1.
project_id = "REPLACE-WITH-GCP_E2E_PROJECT_ID"

# Where the bucket lives. "EU" (multi-region) by default; a single region such as "europe-west3"
# also works. State is tiny, so multi-region costs nothing meaningful.
# location = "EU"

# Override only if the derived name `alethia-tofu-state-<project_id>` is already taken — GCS bucket
# names are globally unique.
# state_bucket_name = "alethia-tofu-state-e2e-gcp"

# How many superseded state generations to keep.
# noncurrent_state_versions_kept = 30

# The access-log sink (#4903) is a SECOND bucket, always named `<state bucket>-logs`. It has no
# override of its own — if that name is taken, change state_bucket_name above and both move.

# How long usage-log shards are kept (30-3650). 90 days, not the 30 used for state generations:
# an unauthorized state read is noticed by its consequences, weeks later.
# access_log_retention_days = 90
