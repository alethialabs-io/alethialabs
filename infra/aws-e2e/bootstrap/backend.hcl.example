# AWS-native S3 backend for the aws-e2e BOOTSTRAP. Copy to backend.hcl (gitignored):
#
#   cp backend.hcl.example backend.hcl
#   AWS_PROFILE=alethia-sso tofu init -backend-config=backend.hcl
#
# The bucket is the Alethia platform account's existing state bucket (the same one infra/aws-oidc
# uses). The key is new, so nothing here can collide with another stack's state.

bucket       = "alethia-tofu-state-270587882865"
key          = "aws-e2e/bootstrap/terraform.tfstate"
region       = "eu-central-1"
use_lockfile = true
