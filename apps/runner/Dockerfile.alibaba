#
# Lean Alibaba-only runner image (per-cloud routing) — `runner-alibaba`. Builds FROM the shared runner-base
# and adds only the Alibaba (ACK) project template. No cloud CLI: the alicloud provider authenticates from
# the keyless OIDC identity (ALICLOUD_ACCESS_KEY / ALICLOUD_SECRET_KEY / ALICLOUD_SECURITY_TOKEN exported by
# the runner), and the ACK kubeconfig comes straight from a tofu output (RequiredCLIs = kubectl, helm — both
# already in the base). Declares ALETHIA_RUNNER_PROVIDERS=alibaba so it only claims Alibaba jobs.

ARG RUNNER_BASE=ghcr.io/alethialabs-io/runner-base:latest
FROM ${RUNNER_BASE}

COPY --chown=runner:runner infra/templates/project/alibaba/ /home/runner/project-templates/alibaba/

USER runner
WORKDIR /home/runner

# Pre-initialize only the Alibaba template (alicloud + random providers). TF_PLUGIN_CACHE_DIR is inherited
# from the base; keeps the .terraform tree warm for the per-job copy.
# NO `-upgrade`: the committed .terraform.lock.hcl decides the provider versions; `-upgrade` disregards
# it and re-resolves against the registry, so the image would drift from what the e2e nightly runs (#1259).
RUN cd /home/runner/project-templates/alibaba && tofu init -backend=false -input=false

ENV ALETHIA_RUNNER_PROVIDERS=alibaba

# The runner's own image ref, baked at build time (#1787). Several renders schedule the runner binary
# as somebody else's sidecar or Job — the keyless DB auth proxy and its bootstrap Job, the xacct
# registry-token refresher — and each fails closed without a ref. It used to be read from
# ALETHIA_RUNNER_IMAGE, which nothing that shipped ever set, so those renders silently refused on
# every deployed runner. The build knows the answer; the operator should not have to.
#
# The default is deliberately EMPTY. A locally built image has no published ref, and baking a guessed
# one would name a different image than the one running — worse than the explicit refusal. Publishing
# workflows pass the FINAL multi-arch tag, never a per-arch one: this ref becomes a sidecar on the
# customer's nodes, so an arm64-only manifest would be unpullable on amd64 nodes.
ARG SELF_IMAGE=""
ENV ALETHIA_RUNNER_SELF_IMAGE=${SELF_IMAGE}
ENTRYPOINT ["runner"]
