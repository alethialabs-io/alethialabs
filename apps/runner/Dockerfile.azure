#
# Lean Azure-only runner image (per-cloud routing) — `runner-azure`. Builds FROM the shared runner-base and
# adds only the Azure project template. CLI-free: AKS cluster auth is minted in-process by the runner
# (`runner kube-token --provider azure`, workload-identity AAD token), so no azure-cli / kubelogin is
# installed. ALETHIA_RUNNER_PROVIDERS=azure → Azure jobs only.

ARG RUNNER_BASE=ghcr.io/alethialabs-io/runner-base:latest
FROM ${RUNNER_BASE}

COPY --chown=runner:runner infra/templates/project/azure/ /home/runner/project-templates/azure/

USER runner
WORKDIR /home/runner

# Pre-initialize only the Azure template. TF_PLUGIN_CACHE_DIR is inherited from the base.
# NO `-upgrade`: the committed .terraform.lock.hcl decides the provider versions; `-upgrade` disregards
# it and re-resolves against the registry, so the image would drift from what the e2e nightly runs (#1259).
RUN cd /home/runner/project-templates/azure && tofu init -backend=false -input=false

ENV ALETHIA_RUNNER_PROVIDERS=azure
ENTRYPOINT ["runner"]
