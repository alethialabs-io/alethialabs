{
	"name": "docs",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"build": "next build",
		"dev": "next dev --experimental-https",
		"start": "next start",
		"types:check": "pnpm run check-types",
		"check-types": "_FUMADOCS_MDX=1 next typegen && fumadocs-mdx && node scripts/check-source-emitted.mjs && tsc --noEmit",
		"check:source-emitted": "node scripts/check-source-emitted.mjs",
		"postinstall": "fumadocs-mdx",
		"lint": "eslint",
		"lint:prose": "vale content"
	},
	"dependencies": {
		"@repo/brand": "workspace:*",
		"fumadocs-core": "16.15.11",
		"fumadocs-mdx": "14.3.2",
		"fumadocs-ui": "16.15.11",
		"lucide-react": "^0.577.0",
		"mermaid": "^12.0.0",
		"next": "16.3.5",
		"next-themes": "^0.4.6",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"tailwind-merge": "^3.7.0"
	},
	"devDependencies": {
		"@tailwindcss/postcss": "^4.3.3",
		"@types/mdx": "^2.0.14",
		"@types/node": "^20.19.43",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"postcss": "^8.5.28",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"eslint-config-next": "16.3.5",
		"eslint": "^9.39.5"
	}
}
