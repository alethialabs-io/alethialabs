#
# Self-host instance secrets — the single list of every secret a self-hosted Alethia instance
# generates for itself.
#
# Every instance secret is declared here, generated per install, and has no default. Nothing in
# the self-host layout supplies a value for any entry: the overlay
# (deploy/selfhost/docker-compose.selfhost.yml) references each `required` entry as
# `${NAME:?…}`, so a missing or empty value stops `docker compose` before any container starts,
# naming the variable.
#
# Credentials an operator obtains from a third party (OAuth apps, email, AI providers, Stripe,
# cloud tokens, an Enterprise licence) are NOT instance secrets and are not listed here; the
# README lists them. Format and lifecycle: deploy/selfhost/README.md.
#
# ── Format ─────────────────────────────────────────────────────────────────────────────────────
# One record per line, whitespace-separated. `#` starts a comment; blank lines are ignored. The
# first word is the record kind:
#
#   generator <id> <command…>
#       How a value of this kind is made. Everything after <id> is a POSIX sh command that prints
#       exactly one value on one line to stdout. It is the canonical definition: the installer
#       implements each <id>, and a validator may run the command to check a value's shape.
#
#   secret <NAME> <generator-id> <presence> <installer> <consumers>
#       NAME       the environment variable, set in the instance's .env
#       generator  a <generator-id> defined above
#       presence   required — the overlay refuses to render without it
#                  optional — unset turns its feature off; the code fails closed
#       installer  yes — deploy/install.sh generates it on a first install today
#                  no  — not generated by the installer yet (lane H1 makes every entry `yes`)
#       consumers  comma-separated compose services that read it
#
# Readers must ignore columns beyond the sixth, so a column can be added without breaking them.
# Rotation keeps the previous value under a second name (ALETHIA_CRED_ENCRYPTION_KEY_<kid>,
# ALETHIA_OIDC_SIGNING_KEY_PREVIOUS). Those hold an earlier value of an entry below, are never
# generated, and are not entries themselves.

# ── Generators ─────────────────────────────────────────────────────────────────────────────────
generator hex16           openssl rand -hex 16
generator hex24           openssl rand -hex 24
generator hex32           openssl rand -hex 32
generator base64-32       openssl rand -base64 32
# base64 of a PKCS#8 PEM RSA-2048 private key, on one line (lib/oidc/issuer.ts imports it).
generator rsa-2048-pem    openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 | openssl base64 -A
# base64 of a PKCS#8 PEM ECDSA P-256 private key, on one line (lib/evidence/receipt-anchor.ts).
generator ec-p256-pem     openssl genpkey -algorithm EC -pkeyopt ec_paramgen_curve:P-256 | openssl base64 -A
# base64 of a raw 64-byte ed25519 private key, seed || public (packages/core/verify/signing.go).
# For ed25519 both DER encodings are fixed-length: the seed is the last 32 bytes of the PKCS#8
# DER and the public key the last 32 bytes of the SPKI DER.
generator ed25519-raw     d=$(mktemp) && openssl genpkey -algorithm ED25519 -outform DER -out "$d" && { tail -c 32 "$d"; openssl pkey -inform DER -in "$d" -pubout -outform DER | tail -c 32; } | openssl base64 -A; rm -f "$d"

# ── Secrets ────────────────────────────────────────────────────────────────────────────────────
#      NAME                                GENERATOR      PRESENCE  INSTALLER  CONSUMERS

# Sessions and cookies (Better Auth).
secret BETTER_AUTH_SECRET                  hex32          required  yes        app
# Signs CLI device-code JWTs.
secret CLI_JWT_SECRET                      hex32          required  yes        app
# Postgres superuser password; migrate and app connect with it.
secret ALETHIA_DB_PASSWORD                 hex24          required  yes        postgres,migrate,app
# Password of the RLS-restricted application role; migrate sets it, app connects with it.
secret ALETHIA_APP_DB_PASSWORD             hex24          required  yes        migrate,app
# AES-256-GCM key sealing connector secrets and alert-channel webhooks at rest. Never swap it in
# place on an instance with data: rotate it (.env.example, next to ALETHIA_CRED_ENCRYPTION_KID).
secret ALETHIA_CRED_ENCRYPTION_KEY         base64-32      required  yes        app
# Password of the OpenFGA datastore (the `enterprise` compose profile).
secret OPENFGA_DB_PASSWORD                 hex24          required  yes        openfga-db,openfga-migrate,openfga
# Object-store identity; the installer also writes it to deploy/seaweedfs/s3.json.
secret ALETHIA_STORAGE_ACCESS_KEY_ID       hex16          required  yes        seaweedfs,app,runner
secret ALETHIA_STORAGE_SECRET_ACCESS_KEY   hex32          required  yes        seaweedfs,app,runner
# HMAC over a job's config snapshot: signed at enqueue, verified at claim.
secret ALETHIA_SNAPSHOT_HMAC_KEY           hex32          required  yes        app
# Bearer for the internal sweep endpoints and the detailed /api/health view.
secret ALETHIA_CRON_SECRET                 hex32          required  yes        app
# Shared bearer the bundled runner presents to /api/runners/bootstrap to register itself.
secret ALETHIA_RUNNER_BOOTSTRAP_TOKEN      hex32          required  no         app,runner
# Workload-identity issuer signing key for keyless AWS, GCP, Azure and Alibaba connectors.
secret ALETHIA_OIDC_SIGNING_KEY            rsa-2048-pem   required  no         app
# Signs evidence receipts.
secret ALETHIA_RECEIPT_SIGNING_KEY         ed25519-raw    required  no         app,runner

# Optional: each enables one feature and nothing reads it otherwise.
# Rekor anchoring of receipt digests; read only when ALETHIA_REKOR_ANCHOR_ENABLED=true.
secret ALETHIA_RECEIPT_ANCHOR_KEY          ec-p256-pem    optional  no         app
# Next.js Server Actions encryption key (scripts/bootstrap-secrets.sh says why a stable value helps).
secret NEXT_SERVER_ACTIONS_ENCRYPTION_KEY  base64-32      optional  no         app
# Bearer for the status-page probe view of /api/health.
secret ALETHIA_STATUS_PROBE_TOKEN          hex32          optional  no         app
# Bearer for the release-metadata publishing routes.
secret RELEASE_API_SECRET                  hex32          optional  no         app
# Bearer for the operator-plane provisioning routes (called by the admin app).
secret PLATFORM_PROVISION_SECRET           hex32          optional  no         app
# Shared secret a break-glass access proxy injects; unset, only the CLI bearer path works.
secret BREAKGLASS_ACCESS_PROXY_SECRET      hex32          optional  no         app
