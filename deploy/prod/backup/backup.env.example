#
# /etc/alethia/backup.env on the production box — root:root, mode 0600, OUTSIDE the checkout (the
# deploy runs `git checkout -f` in /opt/alethia). Written by ops/setup-box.sh from a values file with
# these keys. Read by the systemd units in this directory and by scripts/ops/restore-drill.sh
# --env-file on a drill box. Copy, fill, never commit the filled file.
#
# The values below are production's SHAPE, for the AWS store in the `alethia-backup` account. The
# bucket name and the KMS key ARN come from that stack's outputs; nothing here is a real value.
#
# The two secret values are also kept in the vault (`alethia/prod/env`, keys BACKUP_S3_ACCESS_KEY_ID
# and BACKUP_S3_SECRET_ACCESS_KEY): a backup whose only key lives on the box it backs up is lost with
# the box. See docs/ops/restore-runbook.md.

# ── The off-box store: S3-compatible, at a provider that is NOT Hetzner ──────────────────────────
# Production: AWS S3, eu-central-1, a bucket with versioning, Object Lock and SSE-KMS.
BACKUP_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com
BACKUP_S3_REGION=eu-central-1
# rclone's provider name for the store (AWS, Scaleway, Wasabi, Cloudflare, …); Other works too.
BACKUP_S3_PROVIDER=AWS
# The stack output, e.g. alethia-prod-backup-<account id>.
BACKUP_S3_BUCKET=
# Production: the access key of the IAM user `backup-writer` (Put, Get and List on this prefix, from
# the box's addresses only; no delete). Minted with the CLI, never in tofu state: see the runbook.
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Only for temporary credentials (an STS session). A static IAM user key has no token; leave unset.
# BACKUP_S3_SESSION_TOKEN=
# The ARN of the bucket's KMS key (stack output). Required when the bucket encrypts with SSE-KMS:
# without it the uploads fail rclone's hash check. Leave unset for a store without SSE-KMS.
BACKUP_S3_SSE_KMS_KEY_ID=
BACKUP_PREFIX=alethia-prod

# ── Retention ────────────────────────────────────────────────────────────────────────────────────
# bucket: production. backup.sh never deletes; the bucket's lifecycle rules expire old copies and its
#         Object Lock default retention keeps them immutable until then. Every upload is multipart,
#         which is how the pinned rclone satisfies Object Lock's checksum requirement.
# script: the default when unset, for a store without lifecycle rules. backup.sh deletes copies past
#         BACKUP_KEEP_DAILY / BACKUP_KEEP_WEEKLY itself, so the key above then needs delete too.
BACKUP_RETENTION=bucket

# ── Encryption: age PUBLIC keys only, space separated ────────────────────────────────────────────
# Public keys are not secrets. The matching identities (private keys) are never put on this box:
# the box can write a backup and cannot read one. Production encrypts to three, in this order:
#   1. primary     kept offline in the password manager
#   2. breakglass  kept offline in the password manager and in a second, separate place
#   3. drill       its identity is in the backup account's Secrets Manager, for the weekly drill
# Any one of them can decrypt a copy, so losing one key is not losing the backups.
# ops/generate-age-identities.sh creates all three and prints this line.
BACKUP_AGE_RECIPIENTS=

# ── Optional ─────────────────────────────────────────────────────────────────────────────────────
# BACKUP_KEEP_DAILY=14              # script mode only
# BACKUP_KEEP_WEEKLY=8              # script mode only
# BACKUP_MAX_AGE_HOURS=26
# BACKUP_WORKDIR=/var/tmp           # holds the plaintext bucket copy briefly; needs room for it
# ALETHIA_DIR=/opt/alethia
# ALETHIA_COMPOSE_PROJECT=alethia
# BACKUP_RCLONE_IMAGE=rclone/rclone:1.68.2
