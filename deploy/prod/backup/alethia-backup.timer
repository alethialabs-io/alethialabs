#
# 02:30 UTC daily. B7 asks for a complete copy younger than 26 hours, so one missed night is
# already a failing predicate: Persistent= runs a missed slot at the next boot.
[Unit]
Description=Nightly Alethia off-box backup

[Timer]
OnCalendar=*-*-* 02:30:00 UTC
RandomizedDelaySec=10m
Persistent=true

[Install]
WantedBy=timers.target
