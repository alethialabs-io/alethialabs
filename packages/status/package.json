{
  "name": "@repo/status",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "lint": "eslint . --max-warnings 0",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "build": "esbuild src/worker.ts --bundle --format=esm --target=es2022 --outfile=dist/worker.js",
    "gen:brand": "esbuild scripts/gen-brand.ts --bundle --platform=node --format=cjs --log-level=warning --outfile=dist/gen-brand.cjs && node dist/gen-brand.cjs"
  },
  "devDependencies": {
    "@repo/brand": "workspace:*",
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/node": "22.20.1",
    "@types/react": "19.3.2",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "eslint": "^9.39.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
