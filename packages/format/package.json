    "@types/node": "^22.10.5",
    "@vitest/coverage-v8": "^2.1.9",
    "eslint": "^9.39.5",
    "tsx": "^4.23.12",
    "typescript": "5.9.3",
    "vitest": "^2.1.9"
  }
}
