{
  "id": "vault",
  "mode": "managed",
  "chartRepo": "https://helm.releases.hashicorp.com",
  "chart": "vault",
  "version": "0.28.1",
  "source": "helm",
  "path": "charts/vault",
  "crds": ["rabbitmqclusters.rabbitmq.com"],
  "requiresCertManager": true,
  "project": "infra",
  "namespace": "vault",
  "values": {
    "server": {
      "ha": {
        "enabled": false
      }
    }
  },
  "syncWave": 20,
  "podSecurity": "baseline",
  "secretRef": {
    "secretName": "alethia-addon-vault",
    "namespace": "vault",
    "keys": ["unsealKey"],
    "staticData": {
      "adminUser": "alethia"
    }
  },
  "workloads": [
    {
      "name": "orders-api",
      "bindings": [
        {
          "target": {
            "kind": "database",
            "name": "orders-db",
            "address": "module.db.aws_db_instance.main",
            "output_keys": {
              "endpoint": "db_writer_endpoint",
              "port": "db_port",
              "credential_secret": "db_master_secret_arn"
            }
          },
          "inject": [
            {
              "env": "DATABASE_URL",
              "from": "endpoint"
            }
          ]
        }
      ],
      "valuePaths": {
        "bind:database:orders-db:credential": "postgresql.auth.existingSecret"
      }
    }
  ],
  "bootstrap": {
    "kind": "vault-init",
    "apiBase": "http://vault.vault.svc.cluster.local:8200",
    "stateSecret": "alethia-vault-init"
  }
}
