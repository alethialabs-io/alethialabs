#
# Derived artifacts. `linguist-generated` collapses them in review (they are noise, not code) and,
# more importantly, marks them as machine-owned so nobody tries to resolve a conflict line-by-line.
#
# THE RULE: a conflict in any file below is resolved by RE-RUNNING ITS GENERATOR, never by hand.
# Hand-merging them produces output that no longer corresponds to its source — a lockfile with
# broken checksums, a catalog that disagrees with the adapters that produced it, or (worst) a
# drizzle snapshot chain that silently forks and jams `db:generate` for every worktree.

# ── drizzle migration chain ────────────────────────────────────────────────────────────────────
# NOT merely generated: the snapshots are a LINEAR chain keyed on prevId, so a textual merge can
# produce a file that parses but is structurally invalid. If two branches both generated a
# migration, delete yours (.sql AND snapshot), take dev's, rebase, and re-run `db:generate` — see
# apps/console/scripts/check-migrations.mjs, which fails the PR when two branches claim one index.
apps/console/lib/db/migrations/meta/*.json  linguist-generated=true

# ── connector / capability catalogs (pnpm gen:connectors, gen:catalog) ─────────────────────────
apps/console/lib/connectors/registry.generated.ts  linguist-generated=true
apps/console/lib/db/seed/connectors.generated.sql  linguist-generated=true
packages/core/categories/catalog.json              linguist-generated=true
packages/core/catalog/catalog.json                 linguist-generated=true

# ── compat matrix (pnpm gen:matrix — matrix.json is the SSOT, these are its projections) ───────
apps/console/lib/compat/generated/matrix.ts  linguist-generated=true

# ── programme ledger (pnpm gen:programme · the Go spine export) ────────────────────────────────
# PROGRAMME.md is HALF generated, so it is not marked generated as a whole — the intent half above
# the marker is hand-authored and belongs in review. Only the spine mirror is fully derived.
#
# THE RULE above applies: N sessions all touch PROGRAMME.md, and its generated half is a function of
# the tree, so a conflict there is resolved by RE-RUNNING `pnpm gen:programme` — never by hand-picking
# hunks. Hand-resolving can only produce a status nobody derived, which is the exact failure the
# generated half exists to prevent.
test/e2e/generated/programme.json  linguist-generated=true

# ── Go coverage floors (scripts/go-coverage.sh --update) ──────────────────────────────────────
# THE RULE above applies with unusual force here. These files are laid out as fixed 4-line records
# precisely so that two PRs raising DIFFERENT packages merge cleanly; hand-resolving a conflict
# defeats that and can silently plant a floor no environment ever measured. Re-run the generator.
*/*/coverage-floors.json  linguist-generated=true

# ── lockfile: regenerate with `pnpm install`, never hand-merge ─────────────────────────────────
pnpm-lock.yaml  linguist-generated=true
